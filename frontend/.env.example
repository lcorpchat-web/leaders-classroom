# Copier ce fichier en .env.local puis adapter les valeurs.
# Toutes les variables VITE_* sont publiques (intégrées au code envoyé au navigateur) :
# n'y mettre AUCUN secret.

# Site institutionnel de l'Institut (liens Formations, À propos, Contact, S'inscrire)
VITE_SITE_INSTITUTIONNEL_URL=https://www.institutleaderscorporation.com

# Vidéo de présentation (bouton « Voir la vidéo de présentation ») — facultatif
VITE_VIDEO_PRESENTATION_URL=
