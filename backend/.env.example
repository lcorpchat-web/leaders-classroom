# Copier ce fichier en .env puis adapter les valeurs.

# Environnement : development | production | test
NODE_ENV=development

# Port d'écoute de l'API
PORT=4000

# Origine(s) autorisée(s) pour CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL lancé par docker-compose.yml (port 5434 côté machine)
DATABASE_URL="postgresql://leaders:leaders@localhost:5434/leaders_classroom?schema=public"

# Secret de signature des jetons de session (JWT) — 32 caractères minimum, unique par environnement.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=a-remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum

# Durée de session : standard (heures) et avec « Se souvenir de moi » (jours)
SESSION_DUREE_HEURES=8
SESSION_SOUVENIR_JOURS=30

# Fuseau horaire de référence (affichage des horaires dans les messages du serveur)
FUSEAU_HORAIRE=Africa/Douala

# Adresse publique de l'application (frontend) : retour après la salle et URL de rappel de fin de séance
APP_URL=http://localhost:5173

# BigBlueButton — laisser vide en développement : mode simulation (refusé en production)
# BBB_URL=https://bbb.exemple.com/bigbluebutton/
BBB_URL=
# Secret partagé du serveur BBB (commande « bbb-conf --secret ») — ne jamais le publier
BBB_SECRET=
# Algorithme de signature des appels : sha256 (BBB 2.6+) ou sha1
BBB_CHECKSUM=sha256

# Règles de présence (statut calculé à la clôture de la séance)
PRESENCE_RETARD_MINUTES=10
PRESENCE_DUREE_MIN_POURCENT=50

# Supports de cours : dossier de stockage (hors du dossier public) et taille maximale par fichier
UPLOADS_DIR=uploads
SUPPORT_TAILLE_MAX_MO=25
