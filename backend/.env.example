# Copier ce fichier en .env puis adapter les valeurs.

# Environnement : development | production | test
NODE_ENV=development

# Port d'écoute de l'API
PORT=4000

# Origine(s) autorisée(s) pour CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL lancé par docker-compose.yml (port 5434 côté machine)
DATABASE_URL="postgresql://leaders:leaders@localhost:5434/leaders_classroom?schema=public"

# Secret de signature des jetons de session (JWT) — 32 caractères minimum, unique par environnement.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=a-remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum

# Durée de session : standard (heures) et avec « Se souvenir de moi » (jours)
SESSION_DUREE_HEURES=8
SESSION_SOUVENIR_JOURS=30
