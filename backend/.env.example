# Copier ce fichier en .env puis adapter les valeurs.

# Environnement : development | production | test
NODE_ENV=development

# Port d'écoute de l'API
PORT=4000

# Origine(s) autorisée(s) pour CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (utilisé à partir de l'étape 2 - Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leaders_classroom?schema=public"
